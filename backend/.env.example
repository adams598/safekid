# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Database (PostgreSQL — configure when deploying)
DATABASE_URL=postgresql://user:password@localhost:5432/safekid

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=your_expo_access_token

# Google Maps (Directions API)
# 1. Créer une clé serveur : https://console.cloud.google.com/
# 2. Activer "Directions API" et "Maps JavaScript API"
GOOGLE_MAPS_API_KEY=your_google_maps_server_key
